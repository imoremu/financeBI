table 'Medidas Transacciones'
	lineageTag: 1119b22a-9d0a-4769-8f0c-4498053d07e1

	measure 'Transacciones - Beneficio Bruto Venta Transaccion' = SUM(Transacciones[FIFO Beneficio / Pérdida])
		lineageTag: 48dab9c0-036f-4d25-a7d7-5c8c198b23d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Transacciones - Retenciones Pendientes' =
			
			
			SUM('Transacciones'[IRPF Calculado]) - SUM('Transacciones'[Retenido])
		formatString: 0.00
		lineageTag: 71a0dc06-6a5a-4456-8064-ac9596e940d2

	measure 'Transacciones - Beneficio Bruto Total Periodo' =
			
			
			[Transacciones - Beneficio Bruto Venta Transaccion] + [Transacciones - Beneficio Bruto Dividendo]
		lineageTag: b76497b5-f9e1-4a59-b69a-115c0b296afc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Transacciones - Beneficio Bruto Dividendo' = CALCULATE(SUM(Transacciones[Total Bruto]), Transacciones[Tipo Transacción] = "Dividendos")
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4703907e-48ca-4364-b13a-cf1cfed29a0a

	measure 'Transacciones - Beneficio Neto' = [Transacciones - Beneficio Bruto Total Periodo] - 'Medidas IRPF'[Transacción - IRPF Anual Ahorro]
		lineageTag: 8384ecd4-5ca6-41d1-9547-8008279249e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Transacciones - Total Bruto' = SUM(Transacciones[Total Bruto])
		lineageTag: f9a97217-696e-4840-ae33-22d912ff5179

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Transacciones - Valor Adquisición' = CALCULATE(ABS([Transacciones - Total Bruto]) - [Transacciones - Beneficio Bruto Venta Transaccion], KEEPFILTERS(Transacciones[Tipo Transacción] = "Venta"))
		lineageTag: ed3954bd-3e17-4516-8e40-873f7471d3b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Medidas Transacciones' = m
		mode: import
		queryGroup: Saldo
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

